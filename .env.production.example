# ==============================================================================
# LexTitle AI - Production Environment Variables Configuration Template
# Copy this file to .env before starting in production: cp .env.production.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=production
PORT=8000

# ------------------------------------------------------------------------------
# 1. AI API Keys (Required for Vision OCR & Field Extraction)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=optional_groq_api_key_here
NVIDIA_API_KEY=optional_nvidia_api_key_here
NEMOTRON_DEFAULT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------------------------------------------------------------
# 2. Security & Authentication (CRITICAL: Change in production!)
# Generate a 64-char key with: python3 -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=replace_this_with_a_random_64_character_hex_string_in_production
JWT_SECRET=replace_this_with_a_random_64_character_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. Production Stealth Administrator Credentials
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@lextitle.ai
ADMIN_PASSWORD=replace_with_strong_admin_password_2026!
ADMIN_NAME=LexTitle Chief Administrator
ADMIN_MOBILE=+919876543210

# ------------------------------------------------------------------------------
# 4. Network & CORS Allowed Domains
# Comma-separated list of domains permitted to communicate with this API
# Example: https://app.yourcompany.com,https://yourcompany.com
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://yourdomain.com

# ------------------------------------------------------------------------------
# 5. Production Database Configuration (PostgreSQL with asyncpg connection pooling)
# ------------------------------------------------------------------------------
# PostgreSQL (AWS RDS, Supabase, Neon, Railway, Docker, or self-hosted)
DATABASE_URL=postgresql+asyncpg://lextitle_user:lextitle_secure_pass_2026@localhost:5432/lextitle
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Fallback SQLite path (used ONLY if DATABASE_URL is unset):
DOCFILLER_DB_PATH=/app/data/docfiller.db

# ------------------------------------------------------------------------------
# 6. Payment & Wallet Configurations
# ------------------------------------------------------------------------------
UPI_VPA=lextitle.billing@icici
UPI_PAYEE_NAME=LexTitle AI Legal Systems
ENABLE_WALLET_ENFORCEMENT=false
