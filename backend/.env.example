APP_NAME="DocAuto AI"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Database
DATABASE_URL="sqlite:///./docauto.db"

# Storage
STORAGE_TYPE="local"
STORAGE_DIR="../storage"

# AI Provider Configuration
# Supported AI_PROVIDER values: "huggingface", "fallback"
AI_PROVIDER="huggingface"
HUGGINGFACE_API_TOKEN=""
HUGGINGFACE_MODEL="Qwen/Qwen2.5-72B-Instruct"

# OCR Configuration
OCR_ENGINE="auto" # easyocr, pdfplumber, or auto
