# ==============================================================================
# LexTitle AI - Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env and replace all placeholder values with secure,
# production secrets. NEVER commit .env into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE AI ENGINE (STRICTLY BACKEND ONLY - NEVER EXPOSED TO CLIENT)
# ------------------------------------------------------------------------------
# Official Google Gemini API Key. Obtain from Google AI Studio / Google Cloud.
GEMINI_API_KEY=your_production_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# Secret key used for signing short-lived access tokens.
# Generate a strong 64-char key using: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_at_least_32_chars

# Signing algorithm (Default: HS256)
JWT_ALGORITHM=HS256

# Access token expiry in minutes (Recommended: 15 for production)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token rotation expiry in days (Default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. INITIAL ADMIN BOOTSTRAPPING (OPTIONAL)
# ------------------------------------------------------------------------------
# If provided, an administrator account is securely provisioned at initial startup
# if no admin currently exists. You can also run:
# python -m backend.app.db.bootstrap_admin
ADMIN_EMAIL=admin@yourfirm.com
ADMIN_PASSWORD=SetAStrongPasswordWithLettersAndNumbers123!

# ------------------------------------------------------------------------------
# 4. DATABASE & STORAGE
# ------------------------------------------------------------------------------
# Path to SQLite database file. In Docker, mount /app/data volume.
DOCFILLER_DB_PATH=data/docfiller.db

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000
